{% comment %} ---------- PURCHASE OPTIONS: STYLE AND BEHAVIOUR ---------- {% endcomment %}

<style>
	#shopify-section-{{ section.id }} .offer-lp__plans {
		display: grid;
		gap: 0.5rem;
		margin: 1.25rem 0 1rem;
		text-align: left;
	}

	#shopify-section-{{ section.id }} .offer-lp__plan {
		display: grid;
		grid-template-columns: 1.1rem 1fr;
		gap: 0.75rem;
		align-items: start;
		padding: 0.85rem 1rem;
		border: 1px solid rgba(0, 0, 0, 0.18);
		cursor: pointer;
		transition: border-color 0.2s ease, background-color 0.2s ease;
	}

	#shopify-section-{{ section.id }} .offer-lp__plan.is-selected {
		border-color: var(--cr-orange);
		background-color: rgba(193, 75, 36, 0.06);
	}

	#shopify-section-{{ section.id }} .offer-lp__plan input {
		appearance: none;
		-webkit-appearance: none;
		width: 15px;
		height: 15px;
		margin: 0.25rem 0 0;
		border: 1px solid var(--cr-black);
		border-radius: 0;
		background: transparent;
		cursor: pointer;
		transition: background-color 0.3s;
	}

	#shopify-section-{{ section.id }} .offer-lp__plan input:hover,
	#shopify-section-{{ section.id }} .offer-lp__plan input:checked {
		background-color: var(--cr-orange);
	}

	#shopify-section-{{ section.id }} .offer-lp__plan-body {
		display: grid;
		gap: 0.2rem;
	}

	#shopify-section-{{ section.id }} .offer-lp__plan-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
	}

	#shopify-section-{{ section.id }} .offer-lp__plan-prices {
		display: inline-flex;
		align-items: baseline;
		gap: 0.5rem;
		white-space: nowrap;
	}

	#shopify-section-{{ section.id }} .offer-lp__plan-was {
		font-size: 0.9375rem;
		opacity: 0.5;
	}

	/* The saving, in the brand orange, so the deal reads at a glance. */
	#shopify-section-{{ section.id }} .offer-lp__plan-save {
		font-size: 0.875rem;
		font-weight: 600;
		letter-spacing: 0;
		text-transform: none;
		color: var(--cr-orange);
	}

	/* Sized here rather than with a theme class: t-b-3 is a label style in this
	   theme and renders in caps. Sentence case, one step under the option name. */
	#shopify-section-{{ section.id }} .offer-lp__plan-terms {
		font-size: 0.9375rem;
		line-height: 1.45;
		letter-spacing: 0;
		text-transform: none;
		opacity: 0.65;
		max-width: 46ch;
	}

	#shopify-section-{{ section.id }} .offer-lp__hero-price s,
	#shopify-section-{{ section.id }} .offer-lp__reminder-price s {
		opacity: 0.5;
		margin-right: 0.35rem;
	}

	/* Options and button read as one block: the same width, with the button
	   filling it. Scoped to the hero and the midway reminder, so the sticky bar
	   and the closing banner keep their own button sizes. In the hero they fill
	   the copy block (its width is set in offer-lp.css). */
	#shopify-section-{{ section.id }} .offer-lp__hero .offer-lp__form,
	#shopify-section-{{ section.id }} .offer-lp__reminder .offer-lp__form {
		width: 100%;
		max-width: 36rem;
	}

	#shopify-section-{{ section.id }} .offer-lp__hero .offer-lp__form {
		max-width: none;
	}

	#shopify-section-{{ section.id }} .offer-lp__reminder .offer-lp__form {
		margin-inline: auto;
	}

	#shopify-section-{{ section.id }} .offer-lp__hero .offer-lp__form .c-product-form__cta,
	#shopify-section-{{ section.id }} .offer-lp__reminder .offer-lp__form .c-product-form__cta {
		width: 100%;
		max-width: none;
	}

	/* The closing banner and the sticky bar sit on a photo, where a set of
	   option boxes reads badly. Both keep the button, which carries whichever
	   option is chosen above. */
	#shopify-section-{{ section.id }} .offer-lp__sticky .offer-lp__plans,
	#shopify-section-{{ section.id }} .offer-lp__close .offer-lp__plans {
		display: none;
	}
</style>

<script>
	(function () {
		var root = document.getElementById('shopify-section-{{ section.id }}');
		if (!root) return;

		/* The form is rendered several times on the page: hero, midway, close and
		   the mobile sticky bar. The sticky bar comes after this script in the page,
		   so the forms are looked up each time rather than once, and changes are
		   heard on the section itself. Choosing an option in one form sets the same
		   option in all of them, so the sticky bar always adds what was chosen. */
		function allForms() {
			return Array.prototype.slice.call(root.querySelectorAll('[data-offer-form]'));
		}

		function apply(value) {
			var chosen = null;

			allForms().forEach(function (form) {
				var radios = Array.prototype.slice.call(form.querySelectorAll('input[name="offer-plan"]'));

				radios.forEach(function (radio) {
					var on = radio.value === value;
					radio.checked = on;
					radio.closest('.offer-lp__plan').classList.toggle('is-selected', on);
					if (on && !chosen) chosen = radio;
				});

				var planInput = form.querySelector('[data-offer-plan]');
				if (planInput) {
					planInput.value = value;
					planInput.disabled = !value;   /* a disabled input isn't submitted */
				}
			});

			if (!chosen) return;

			var pay = chosen.getAttribute('data-pay');
			var was = chosen.getAttribute('data-was');
			var stickyNow = root.querySelector('[data-sticky-now]');
			var stickyWas = root.querySelector('[data-sticky-was]');

			if (stickyNow && pay) stickyNow.textContent = pay;
			if (stickyWas && was) stickyWas.textContent = was;
			root.querySelectorAll('[data-offer-now]').forEach(function (el) { if (pay) el.textContent = pay; });
			root.querySelectorAll('[data-offer-was]').forEach(function (el) { if (was) el.textContent = was; });
		}

		root.addEventListener('change', function (e) {
			if (!e.target || e.target.name !== 'offer-plan') return;
			apply(e.target.value);
		});

		function init() {
			var first = root.querySelector('input[name="offer-plan"]:checked');
			if (first) apply(first.value);
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', init);
		} else {
			init();
		}
	})();
</script>

<script>
	/* Focused page (Rose): no route from this page to the rest of the store,
	   where the jar sells at full price.
	   - Links to the home page (the header and footer logos) stop being links.
	   - Any other link to a store page is blocked, including links that apps
	     (the reviews widget) or the cart drawer add after the page loads.
	   - Legal links (privacy, terms, FDA disclaimer) stay and open in a new tab,
	     so this page stays where it is.
	   Cart, checkout, links within this page and outside sites are untouched.
	   Same script as the sachet page. */
	(function () {
		if (window.__amplifyeFocusLinks) return;
		window.__amplifyeFocusLinks = true;

		var here = location.pathname.replace(/\/+$/, '') || '/';
		var storePage = /^\/(products|collections|pages|blogs|search|account|policies)(\/|$)/;
		var legal = /privacy|terms|disclaimer|polic|refund|legal|accessib|cookie/i;

		function classify(a) {
			if (a.hasAttribute('data-focus-off')) return 'off';

			var href = a.getAttribute('href');
			if (!href || href.charAt(0) === '#') return 'keep';

			var url;
			try { url = new URL(href, location.href); } catch (e) { return 'keep'; }
			if (url.origin !== location.origin) return 'keep';

			var path = url.pathname.replace(/\/+$/, '') || '/';
			if (path === here) return 'keep';
			if (path === '/') return 'off';
			if (!storePage.test(path)) return 'keep';
			if (legal.test(path)) return 'newtab';
			return 'off';
		}

		function switchOff(a) {
			a.removeAttribute('href');
			a.setAttribute('data-focus-off', '');
		}

		function newTab(a) {
			a.setAttribute('target', '_blank');
			a.setAttribute('rel', 'noopener');
		}

		function sweep() {
			document.querySelectorAll('a[href]').forEach(function (a) {
				var kind = classify(a);
				if (kind === 'off') switchOff(a);
				else if (kind === 'newtab') newTab(a);
			});
		}

		function guard(e) {
			var a = e.target && e.target.closest ? e.target.closest('a') : null;
			if (!a) return;

			var kind = classify(a);
			if (kind === 'off') {
				e.preventDefault();
				e.stopPropagation();
				switchOff(a);
			} else if (kind === 'newtab') {
				newTab(a);
			}
		}

		document.addEventListener('click', guard, true);
		document.addEventListener('auxclick', guard, true);

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', sweep);
		} else {
			sweep();
		}
	})();
</script>

{% comment %} ---------- STICKY ---------- {% endcomment %}

<div class="offer-lp__sticky">
	<div class="offer-lp__sticky-inner">
		<div class="offer-lp__sticky-price">
			<span class="offer-lp__sticky-was t-b-4" data-sticky-was>{% if has_sub %}{{ sub_price | money }}{% else %}{{ base_price | money }}{% endif %}</span>
			<span class="offer-lp__sticky-now t-l-2" data-sticky-now>{% if has_sub %}{{ sub_first | money }}{% else %}{{ offer_price | money }}{% endif %}</span>
		</div>
		<div class="offer-lp__cta offer-lp__sticky-cta">{{ buy_form }}</div>
	</div>
</div>
