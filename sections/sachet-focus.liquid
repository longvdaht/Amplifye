{% comment %}
	Sachet funnel: the header, footer and links for the sachet page and its
	two sachet-only pages (Benefits and The Science). It goes first on each
	of the three templates and shows nothing of its own.

	Header (Jenny, 7 Oct): "P24 ENZYME" is gone, "BENEFITS" and "THE SCIENCE"
	sit in the center and open the sachet versions of those pages. The logo
	opens the sachet page. BUY P24 (the jar) is hidden. Cart and account stay.

	Footer: as on the sachet page so far, no menu or social links (Rose: no
	route to the rest of the store, where the jar sells at other prices).
	Settings below can show them; the menu then follows the same rules as
	the header. Legal links stay and open in a new tab.

	Every link on these pages:
	  - the three funnel pages, cart, checkout, account, anchors on the page
	    and outside sites: unchanged
	  - the home page and the jar's product page: the sachet page
	  - the jar's Benefits and The Science pages: the sachet versions
	  - legal pages (privacy, terms, disclaimer...): open in a new tab
	  - a discount link that lands on a product: the sachet page, no code
	  - anything else in the store (collections, blogs, other pages and
	    products, search): switched off; in a menu, the item is hidden
	Links that apps or the cart drawer add later get the same treatment.

	While checking with ?view=..., the sachet links on the two pages keep
	that ?view, so the whole funnel can be clicked through before the
	template is assigned to the product.
{% endcomment %}

{%- liquid
	assign s = section.settings
	assign sachet_url = s.sachet_url | default: '/products/sachets'
	assign benefits_url = s.benefits_url | default: '/pages/sachets-benefits'
	assign science_url = s.science_url | default: '/pages/sachets-science'
	assign jar_url = s.jar_url | default: '/products/amplifye-p24'
-%}

<style>
	/* This section takes no space. */
	.sachet-focus {
		display: none !important;
	}

	/* BUY P24 links to the jar. */
	.g-header__cta {
		display: none !important;
	}

	/* "P24 ENZYME" (the jar's product page) is taken out of the menus here,
	   before the page shows; the script below covers older browsers. */
	.g-header__nav li:has(a[href*="/products/"]),
	.g-mobile-menu li:has(a[href*="/products/"]),
	[data-funnel-hidden] {
		display: none !important;
	}

	{%- unless s.show_account %}
	.g-header__account {
		display: none !important;
	}
	{%- endunless %}

	{%- unless s.show_footer_menu %}
	.g-footer__nav {
		display: none !important;
	}
	{%- endunless %}

	{%- unless s.show_footer_social %}
	.g-footer__social {
		display: none !important;
	}
	{%- endunless %}

	a[data-funnel-off] {
		cursor: default;
	}

	{%- unless s.show_footer_menu %}
	/* With the footer menu hidden, the wordmark moves up beside the email
	   signup and would squeeze it at laptop widths. Same fix as the offer
	   pages: one line, the signup held at 280px, the wordmark shrinks. */
	@media screen and (min-width: 1025px) {
		.g-footer__content {
			flex-wrap: nowrap;
		}

		.g-footer__email-capture {
			min-width: 280px;
		}

		.g-footer__logo {
			flex-shrink: 1;
			min-width: 0;
		}

		.g-footer__logo svg {
			width: 100%;
			height: auto;
		}
	}
	{%- endunless %}
</style>

<script>
	(function () {
		if (window.__amplifyeSachetFunnel) return;
		window.__amplifyeSachetFunnel = true;

		var cfg = {
			sachet: {{ sachet_url | json }},
			benefits: {{ benefits_url | json }},
			science: {{ science_url | json }},
			jar: {{ jar_url | json }},
			footerMenu: {{ s.show_footer_menu | json }},
			hosts: [{{ request.host | json }}, {{ shop.domain | json }}, {{ shop.permanent_domain | json }}]
		};

		var STORE_PAGE = /^\/(products|collections|pages|blogs|search|policies|discount)(\/|$)/;
		var LEGAL = /privacy|terms|disclaimer|polic|refund|legal|accessib|cookie|shipping-policy/i;
		var LOCALE = /^\/[a-z]{2}(?:-[a-z]{2})?(?=\/(?:products|collections|pages|blogs|search|policies|discount|cart|account)(?:\/|$))/i;
		var MENUS = '.g-header__nav, .g-mobile-menu' + (cfg.footerMenu ? ', .g-footer__nav' : '');

		function host(h) {
			return String(h || '').toLowerCase().replace(/^www\./, '');
		}

		var storeHosts = cfg.hosts.map(host).filter(Boolean);

		function cleanPath(p) {
			p = String(p || '/').replace(LOCALE, '');
			p = p.replace(/\/+$/, '') || '/';
			return p.toLowerCase();
		}

		function pathOf(u) {
			try { return cleanPath(new URL(u, location.origin).pathname); } catch (e) { return ''; }
		}

		function handleOf(path) {
			var m = path.match(/\/products\/([^\/?#]+)/);
			return m ? m[1] : '';
		}

		var SACHET = pathOf(cfg.sachet);
		var BENEFITS = pathOf(cfg.benefits);
		var SCIENCE = pathOf(cfg.science);
		var SACHET_HANDLE = handleOf(SACHET);
		var JAR_HANDLE = handleOf(pathOf(cfg.jar));

		/* QA: keep ?view=... on links back to the sachet page, for the
		   browser session, once the sachet page has been opened with it. */
		var VIEW_KEY = 'amp_funnel_view';
		try {
			var params = new URLSearchParams(location.search);
			if (cleanPath(location.pathname) === SACHET && params.get('view')) {
				sessionStorage.setItem(VIEW_KEY, params.get('view'));
			}
		} catch (e) {}

		function qaView() {
			try { return sessionStorage.getItem(VIEW_KEY); } catch (e) { return null; }
		}

		function sachetHref(hash) {
			var view = qaView();
			return cfg.sachet + (view ? '?view=' + encodeURIComponent(view) : '') + (hash || '');
		}

		/* A link that already goes to the sachet page: add the QA ?view if
		   there is one and the link has none. */
		function withView(url) {
			var view = qaView();
			if (!view || url.searchParams.has('view')) return null;
			url.searchParams.set('view', view);
			return { to: url.pathname + url.search + url.hash };
		}

		/* What happens to one link: null (leave it), {to: url}, {newtab: true}
		   or {off: true}. 'jar' marks links to the jar's product page. */
		function decide(a) {
			var href = a.getAttribute('href');
			if (href == null) return null;
			href = href.trim();
			if (!href || href.charAt(0) === '#' || /^(mailto|tel|sms|javascript):/i.test(href)) return null;

			var url;
			try { url = new URL(href, location.href); } catch (e) { return null; }
			if (!/^https?:$/.test(url.protocol)) return null;
			if (storeHosts.indexOf(host(url.hostname)) === -1) return null;

			var path = cleanPath(url.pathname);
			var hash = url.hash || '';

			if (path === SACHET) return withView(url);
			if (path === BENEFITS || path === SCIENCE) return null;
			if (path === '/') return { to: sachetHref(hash) };
			if (path === '/pages/benefits') return { to: cfg.benefits + hash };
			if (path === '/pages/the-science') return { to: cfg.science + hash };
			if (!STORE_PAGE.test(path)) return null;
			if (LEGAL.test(path)) return { newtab: true };

			var handle = handleOf(path);
			if (handle) {
				if (handle === SACHET_HANDLE) return withView(url);
				if (handle === JAR_HANDLE) return { to: sachetHref(hash), jar: true };
				return { off: true };
			}

			if (/^\/discount\//.test(path)) {
				var redirect = url.searchParams.get('redirect') || '';
				if (/\/products\//i.test(redirect)) return { to: sachetHref('') };
				return { off: true };
			}

			return { off: true };
		}

		function inMenu(a) {
			return !!(a.closest && a.closest(MENUS));
		}

		function hideItem(a) {
			var item = a.closest('li') || a;
			item.setAttribute('data-funnel-hidden', '');
		}

		function switchOff(a) {
			a.removeAttribute('href');
			a.setAttribute('data-funnel-off', '');
			a.setAttribute('aria-disabled', 'true');
		}

		function apply(a) {
			var d = decide(a);
			if (!d) return d;

			if (inMenu(a) && (d.off || d.jar)) {
				hideItem(a);
				switchOff(a);
				return d;
			}

			if (d.to) {
				a.setAttribute('href', d.to);
			} else if (d.newtab) {
				a.setAttribute('target', '_blank');
				var rel = (a.getAttribute('rel') || '').split(/\s+/);
				if (rel.indexOf('noopener') === -1) rel.push('noopener');
				a.setAttribute('rel', rel.join(' ').trim());
			} else if (d.off) {
				switchOff(a);
			}
			return d;
		}

		function sweep(rootNode) {
			var scope = rootNode && rootNode.querySelectorAll ? rootNode : document;
			if (scope.tagName === 'A') apply(scope);
			scope.querySelectorAll('a[href]').forEach(apply);
		}

		/* Clicks on links that changed or appeared since the last sweep. */
		function guard(e) {
			var a = e.target && e.target.closest ? e.target.closest('a') : null;
			if (!a) return;
			if (a.hasAttribute('data-funnel-off')) {
				e.preventDefault();
				e.stopPropagation();
				return;
			}
			var d = apply(a);
			if (d && d.off) {
				e.preventDefault();
				e.stopPropagation();
			}
		}

		document.addEventListener('click', guard, true);
		document.addEventListener('auxclick', guard, true);

		/* "BENEFITS" and "THE SCIENCE" centered on the page, not just in the
		   space between the logo and the cart. Measured from the links that
		   show, so it holds whatever the menu's markup is. */
		var nav = null;

		function centerNav() {
			nav = nav || document.querySelector('.g-header__nav');
			if (!nav) return;

			nav.style.left = '';
			var cs = window.getComputedStyle(nav);
			if (cs.display === 'none' || cs.visibility === 'hidden') return;
			if (cs.position !== 'static' && cs.position !== 'relative') return;

			var bar = nav.closest('.g-header') || document.documentElement;
			var minLeft = Infinity;
			var maxRight = -Infinity;

			nav.querySelectorAll('a').forEach(function (a) {
				var r = a.getBoundingClientRect();
				if (!r.width || !r.height) return;
				if (r.left < minLeft) minLeft = r.left;
				if (r.right > maxRight) maxRight = r.right;
			});

			if (!isFinite(minLeft) || !isFinite(maxRight)) return;

			var b = bar.getBoundingClientRect();
			var shift = Math.round((b.left + b.width / 2) - (minLeft + maxRight) / 2);
			if (Math.abs(shift) < 2) return;

			if (cs.position === 'static') nav.style.position = 'relative';
			nav.style.left = shift + 'px';
		}

		var queued = false;
		function queueCenter() {
			if (queued) return;
			queued = true;
			window.requestAnimationFrame(function () {
				queued = false;
				centerNav();
			});
		}

		/* Run now (the header is already on the page), again when the page and
		   its fonts finish loading, and whenever the header changes size. */
		sweep(document);
		centerNav();

		function ready() {
			sweep(document);
			centerNav();

			if (window.MutationObserver) {
				new MutationObserver(function (records) {
					records.forEach(function (rec) {
						if (rec.type === 'attributes') {
							if (rec.target.tagName === 'A') apply(rec.target);
							return;
						}
						rec.addedNodes.forEach(function (node) {
							if (node.nodeType === 1) sweep(node);
						});
					});
				}).observe(document.body, { childList: true, subtree: true, attributes: true, attributeFilter: ['href'] });
			}

			var header = document.querySelector('.g-header');
			if (header && window.ResizeObserver) {
				new ResizeObserver(queueCenter).observe(header);
			}
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', ready);
		} else {
			ready();
		}

		window.addEventListener('load', queueCenter);
		window.addEventListener('resize', queueCenter);
		if (document.fonts && document.fonts.ready) document.fonts.ready.then(queueCenter);
	})();
</script>

{% schema %}
{
	"name": "Sachet funnel links",
	"tag": "div",
	"class": "sachet-focus",
	"settings": [
		{
			"type": "paragraph",
			"content": "Keeps visitors inside the sachet funnel: the sachet page and its own Benefits and The Science pages. Put this section first on each of those three templates. It shows nothing itself."
		},
		{ "type": "text", "id": "sachet_url", "label": "Sachet page", "default": "/products/sachets" },
		{ "type": "text", "id": "benefits_url", "label": "Sachet Benefits page", "default": "/pages/sachets-benefits" },
		{ "type": "text", "id": "science_url", "label": "Sachet The Science page", "default": "/pages/sachets-science" },
		{ "type": "text", "id": "jar_url", "label": "Jar product page", "info": "Links to it go to the sachet page; the menu item for it is hidden.", "default": "/products/amplifye-p24" },
		{ "type": "checkbox", "id": "show_account", "label": "Show the account icon", "default": true },
		{ "type": "checkbox", "id": "show_footer_menu", "label": "Show the footer menu", "info": "Off as on the sachet page so far. When on, store links in it are hidden the same way as in the header.", "default": false },
		{ "type": "checkbox", "id": "show_footer_social", "label": "Show the footer social icons", "default": false }
	],
	"presets": [{ "name": "Sachet funnel links" }]
}
{% endschema %}
